      "item": [
        {
          "name": "Search — mặc định (không bộ lọc, sắp xếp BR2)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/mua-hang/chung-tu-mua-hang/search",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "mua-hang",
                "chung-tu-mua-hang",
                "search"
              ]
            },
            "description": "Request rỗng lấy TẤT CẢ (trong giới hạn tenant + chưa xoá). BE không tự bơm bộ lọc thời gian — theo quyết định D3, việc đó thuộc FE.\n\nThứ tự mặc định BR2: coalesce(ngày hạch toán, ngày chứng từ, ngày tạo) giảm dần → số chứng từ tăng dần → id.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"page\": 1,\n  \"pageSize\": 20\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('envelope danh sách', () => {",
                  "  pm.expect(b).to.have.property('data');",
                  "  pm.expect(b).to.have.property('pagination');",
                  "  pm.expect(b.pagination).to.have.all.keys('page','pageSize','totalItems','totalPages');",
                  "});",
                  "pm.test('có dòng tổng cộng 3 cột tiền (BR31)', () => {",
                  "  pm.expect(b.summary).to.have.all.keys('tongTienThanhToanQuyDoi','chiPhiQuyDoi','tongGiaTriNhapKhoQuyDoi');",
                  "});",
                  "if (b.data && b.data.length) {",
                  "  pm.collectionVariables.set('ctmhId', b.data[0].id);",
                  "  pm.test('enum trả TÊN HẰNG, không phải chuỗi DB', () => {",
                  "    pm.expect(b.data[0].loaiNghiepVu).to.match(/^[A-Z_]+$/);",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Search — đủ 10 tiêu chí của SCR_CTMH_DanhSach",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/mua-hang/chung-tu-mua-hang/search",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "mua-hang",
                "chung-tu-mua-hang",
                "search"
              ]
            },
            "description": "Toàn bộ 10 ô tìm kiếm trên cột, ghép bằng AND (BR11.2.2).\nLưu ý: `status` (không phải `trangThai`), và mọi giá trị enum là TÊN HẰNG.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"page\": 1,\n  \"pageSize\": 20,\n  \"sort\": \"ngayHachToan:desc,soChungTu:asc\",\n  \"logic\": \"AND\",\n  \"filters\": [\n    {\n      \"field\": \"ngayHachToan\",\n      \"op\": \"between\",\n      \"value\": [\n        \"2026-08-01\",\n        \"2026-08-31\"\n      ]\n    },\n    {\n      \"field\": \"soChungTu\",\n      \"op\": \"like\",\n      \"value\": \"PNK\"\n    },\n    {\n      \"field\": \"soHoaDon\",\n      \"op\": \"like\",\n      \"value\": \"0001\"\n    },\n    {\n      \"field\": \"tenNhaCungCap\",\n      \"op\": \"like\",\n      \"value\": \"cong ty\"\n    },\n    {\n      \"field\": \"loaiNghiepVu\",\n      \"op\": \"in\",\n      \"value\": [\n        \"NHAP_KHO\",\n        \"KHONG_QUA_KHO\"\n      ]\n    },\n    {\n      \"field\": \"hinhThuc\",\n      \"op\": \"in\",\n      \"value\": [\n        \"NHAP_KHAU\"\n      ]\n    },\n    {\n      \"field\": \"status\",\n      \"op\": \"in\",\n      \"value\": [\n        \"DA_GHI_SO\"\n      ]\n    },\n    {\n      \"field\": \"trangThaiNhanHoaDon\",\n      \"op\": \"in\",\n      \"value\": [\n        \"CHUA_NHAN\"\n      ]\n    },\n    {\n      \"field\": \"trangThaiThanhToan\",\n      \"op\": \"in\",\n      \"value\": [\n        \"CHUA_THANH_TOAN\"\n      ]\n    },\n    {\n      \"field\": \"tinhTrangPhanBo\",\n      \"op\": \"in\",\n      \"value\": [\n        \"PHAN_BO_MOT_PHAN\"\n      ]\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
