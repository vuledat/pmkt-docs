    {
      "name": "3. Chứng từ liên quan (SCR_CTMH_DSChungTuLienQuan)",
      "item": [
        {
          "name": "Danh sách chứng từ liên quan",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/mua-hang/chung-tu-mua-hang/{{ctChiPhiId}}/chung-tu-lien-quan",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "mua-hang",
                "chung-tu-mua-hang",
                "{{ctChiPhiId}}",
                "chung-tu-lien-quan"
              ]
            },
            "description": "{{ctChiPhiId}} = id chứng từ CHI PHÍ đang bị thao tác xoá. Form mở ra từ cảnh báo MSG_PMKT-E-00485_129 khi người dùng chọn \"Có\".\n\nTrả TOÀN BỘ, không phân trang (BR_CTMH_DSLQ_01 \"load lên tất cả\"). Thứ tự BR_CTMH_DSLQ_02: ngày hạch toán tăng dần → số chứng từ tăng dần.\n\nQuyền .Delete chứ không .View: form chỉ tồn tại trong luồng xoá.\n\nCột \"Loại chứng từ\" trả MÃ (loaiNghiepVu + hinhThuc + hinhThucThanhToan + loaiChungTuId), FE ghép nhãn bằng i18n — xem §11-Q9."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json().data;",
                  "pm.test('sắp xếp tăng dần theo ngày hạch toán', () => {",
                  "  const ngay = d.map(x => x.ngayHachToan).filter(Boolean);",
                  "  pm.expect(ngay).to.eql([...ngay].sort());",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Xuất Excel danh sách liên quan (theo bộ lọc đang hiển thị)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
